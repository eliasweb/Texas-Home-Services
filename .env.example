# Copy to .env and fill in. For Vercel, set this in Project Settings → Environment Variables.
#
# Neon (recommended): https://console.neon.tech/ — create a project, copy the
# pooled connection string from the dashboard. It looks like:
#   postgresql://USER:PASSWORD@ep-xxxx-pooler.region.aws.neon.tech/dbname?sslmode=require
#
# For Prisma migrations you may also want a non-pooled (direct) URL — Neon
# provides both. If you set DIRECT_URL, uncomment the matching block in
# prisma/schema.prisma.

DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"
